{
  "name": "gp",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "record": "pnpm --filter @gp/cli record",
    "replay": "pnpm --filter @gp/cli replay",
    "inspect": "pnpm --filter @gp/cli inspect",
    "desktop": "pnpm --filter @gp/desktop dev",
    "chat": "pnpm --filter @gp/cli chat",
    "ptt-test": "pnpm --filter @gp/cli ptt-test",
    "gate-test": "pnpm --filter @gp/cli gate-test",
    "history": "pnpm --filter @gp/cli history",
    "ingest": "pnpm --filter @gp/cli ingest",
    "package": "pnpm --filter @gp/desktop package"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.10.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
