{
  "name": "gp",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "record": "pnpm --filter @gp/cli record",
    "replay": "pnpm --filter @gp/cli replay",
    "inspect": "pnpm --filter @gp/cli inspect",
    "desktop": "pnpm --filter @gp/desktop dev",
    "chat": "pnpm --filter @gp/cli chat",
    "ptt-test": "pnpm --filter @gp/cli ptt-test",
    "gate-test": "pnpm --filter @gp/cli gate-test",
    "history": "pnpm --filter @gp/cli history",
    "ingest": "pnpm --filter @gp/cli ingest"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
