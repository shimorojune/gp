{
  "name": "@gp/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GP design system: tokens, CSS and framework-free components for the desktop renderer",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./gp-ui.css": "./dist/gp-ui.css"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "styleguide": "node scripts/build.mjs --styleguide --open",
    "screenshot": "node scripts/build.mjs --styleguide && node scripts/screenshot.mjs",
    "typecheck": "tsc -p .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.2.8",
    "@fontsource-variable/inter": "5.3.0",
    "@gp/shared": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
